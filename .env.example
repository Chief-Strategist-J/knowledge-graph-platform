# Sanitized example environment configuration for Knowledge Graph Platform
APP_ENV=development
PORT=8000
GRPC_PORT=9090

# Database & Cache Secrets / Endpoints
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=knowledge_graph
POSTGRES_USER=kg_admin
POSTGRES_PASSWORD=replace_with_secure_password
PG_PASSWORD_FILE=deploy/release/secrets/pg_password.txt

NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=replace_with_secure_password

QDRANT_HOST=127.0.0.1
QDRANT_PORT=6334

OPENSEARCH_URL=https://127.0.0.1:9200
OPENSEARCH_PASSWORD=AdminPassword123!

KAFKA_BROKERS=127.0.0.1:9092
REDIS_HOST=127.0.0.1:6379
REDIS_PASSWORD=replace_with_secure_password

MINIO_ENDPOINT=http://127.0.0.1:9000
MINIO_USER=minioadmin
MINIO_PASSWORD=replace_with_secure_password

# Telemetry & Observability
OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4317
OTEL_EXPORTER_OTLP_HTTP_ENDPOINT=http://127.0.0.1:4318
PROMETHEUS_ENDPOINT=http://127.0.0.1:9090
LOKI_ENDPOINT=http://127.0.0.1:3100
TEMPO_ENDPOINT=http://127.0.0.1:3200
GRAFANA_PORT=13000

# Container Registry & Digests
REGISTRY=ghcr.io/knowledge-graph-platform
APP_IMAGE=ghcr.io/knowledge-graph-platform/knowledge-graph-platform:1.0.0
WORKER_IMAGE=ghcr.io/knowledge-graph-platform/knowledge-graph-docling-worker:1.0.0
APP_DIGEST=sha256:4d603a1168f02f6efbaee5e2df808b8db4e43cf6dd53ca2f6fef95b1ad2c3771
WORKER_DIGEST=sha256:d6b63d6e52003d157a9f029ce62d29b0270a3c75abf1675c9bb0d8434771aa1e
