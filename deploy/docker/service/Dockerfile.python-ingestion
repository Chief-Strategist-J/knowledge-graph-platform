# syntax=docker/dockerfile:1.7
ARG BUILDER_IMAGE=python:3.12.7-bookworm@sha256:6e1fb28751478ec1eb31a2931a5518fd516ea278fef8ebba63f8bb1a48c9735b
ARG BASE_IMAGE=python:3.12.7-slim-bookworm@sha256:d6b63d6e52003d157a9f029ce62d29b0270a3c75abf1675c9bb0d8434771aa1e

# ---------- Stage 1: Builder ----------
FROM ${BUILDER_IMAGE} AS builder
WORKDIR /build

ENV PIP_DISABLE_PIP_VERSION_CHECK=1 PIP_NO_CACHE_DIR=0
RUN python -m venv /opt/venv

RUN /opt/venv/bin/pip install --no-cache-dir docling pydantic pyyaml sentence-transformers

# ---------- Stage 2: Hardened Runtime ----------
FROM ${BASE_IMAGE} AS runtime

ARG APP_UID=10001
ARG APP_GID=10001

SHELL ["/bin/bash", "-o", "pipefail", "-c"]

RUN apt-get update \
 && apt-get install -y --no-install-recommends ca-certificates tzdata tini \
 && rm -rf /var/lib/apt/lists/* \
 && groupadd --gid ${APP_GID} app \
 && useradd  --uid ${APP_UID} --gid ${APP_GID} --no-create-home --shell /usr/sbin/nologin app \
 && mkdir -p /app && chown ${APP_UID}:${APP_GID} /app

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PATH="/opt/venv/bin:${PATH}" \
    HOME=/tmp \
    LANG=C.UTF-8 \
    TZ=UTC

COPY --from=builder /opt/venv /opt/venv

WORKDIR /app
USER ${APP_UID}:${APP_GID}

EXPOSE 8001

ENTRYPOINT ["/usr/bin/tini", "--"]
CMD ["python", "-m", "worker.main"]
