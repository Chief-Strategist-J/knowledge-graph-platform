$schema: "https://json-schema.org/draft/2020-12/schema"
title: "PlatformConfig"
type: "object"
required:
  - "server"
properties:
  server:
    type: "object"
    required:
      - "name"
      - "bind_address"
      - "admin_bind_address"
    properties:
      name:
        type: "string"
      bind_address:
        type: "string"
      admin_bind_address:
        type: "string"
      idle_timeout_seconds:
        type: "integer"
        minimum: 1
      header_timeout_seconds:
        type: "integer"
        minimum: 1
      drain_deadline_seconds:
        type: "integer"
        minimum: 1
      propagation_wait_seconds:
        type: "integer"
        minimum: 0
      shutdown_deadline_seconds:
        type: "integer"
        minimum: 1
